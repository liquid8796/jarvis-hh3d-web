# ============================================================================
# Jarvis HH3D Web — environment
# Copy to .env for local dev; set the same keys in Vercel → Project → Settings
# → Environment Variables for production.
# ============================================================================

# Neon Postgres connection string (Vercel Marketplace → Neon integration creates
# this automatically as DATABASE_URL; locally, copy it from the Neon dashboard).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 32+ random bytes, base64/hex — signs the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Shared secret the automation worker presents on every call to /api/worker/*.
# Generate the same way as AUTH_SECRET. Rotate it to cut a worker off.
WORKER_TOKEN="change-me"

# First admin account, created by `npm run db:seed` (idempotent).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong"
