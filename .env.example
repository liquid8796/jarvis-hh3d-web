# ============================================================================
# Jarvis HH3D Web — environment
# Copy to .env for local dev; set the same keys in Vercel → Project → Settings
# → Environment Variables for production.
# ============================================================================

# Neon Postgres connection string (Vercel Marketplace → Neon integration creates
# this automatically as DATABASE_URL; locally, copy it from the Neon dashboard).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Tuỳ chọn cho SSE realtime: kết nối KHÔNG qua transaction pooler và PHẢI trỏ đúng cùng DB
# với DATABASE_URL. Neon/Vercel thường đã cấp PGHOST_UNPOOLED nên có thể để trống; code sẽ
# thay riêng hostname nhưng giữ nguyên database/path/credentials của DATABASE_URL.
REALTIME_DATABASE_URL=""

# 32+ random bytes, base64/hex — signs the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Mã hoá at-rest cho cookie game (AES-256-GCM). ĐÚNG 32 byte: 64 ký tự hex, hoặc base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MẤT KHOÁ NÀY = mọi cookie đã lưu không giải mã được nữa (người dùng phải dán lại).
# ĐỔI KHOÁ cũng vậy — hãy coi nó như một bí mật vĩnh viễn của deployment.
ENCRYPTION_KEY="change-me"

# Token của LINH SỨ TÔNG MÔN — worker do người vận hành nuôi (VM Oracle Always Free, xem
# deploy/oracle/). Cầm token này là nhận được job của MỌI thành viên, nên nó chỉ nằm ở hai
# chỗ: Vercel env và file env trên VM. Đạo hữu cài linh sứ máy nhà thì dùng LINH PHÙ riêng
# phát ở mục Linh Sứ trên dashboard — không bao giờ đưa token này cho họ.
# Generate the same way as AUTH_SECRET. Rotate it to cut the sect worker off.
WORKER_TOKEN="change-me"

# First admin account, created by `npm run db:seed` (idempotent).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong"

# Địa chỉ web mà linh sứ gọi ngược về để nhận việc và kể chuyện.
#   Trên VM/worker: https://<app>.vercel.app  (kèm scheme — thiếu https:// là fetch hỏng)
#   Máy dev       : để trống, worker tự dùng http://localhost:3000
WEB_URL=""

# Linh sứ đang bận hỏi trạng thái Thu Đàn theo nhịp này. 5000ms = phản hồi nhanh nhưng vẫn nhẹ;
# chỉ đặt trên máy nuôi worker, không cần đặt ở Vercel.
WORKER_HEARTBEAT_MS="5000"

# Cho phép gọi /api/cron từ bên ngoài. Cron thật của Vercel được nhận diện qua user-agent
# nên không cần biến này — nhưng nếu bạn dùng dịch vụ cron ngoài (cron-job.org…) để quét
# dọn dày hơn nhịp 1 lần/ngày của gói Hobby thì đây là chìa khoá của nó. Từ v0.11 cron chỉ
# còn là lưới an toàn vệ sinh (job mồ côi, tin đàm đạo quá hạn) — không lái automation nữa.
CRON_SECRET=""

# Tên miền game. Site đổi TLD định kỳ (…mx → …am), nên đây là cấu hình chứ không phải hằng
# số trong code. Để trống = dùng mặc định trong src/lib/quest-engine/runCycle.mjs.
GAME_BASE_URL=""

# Danh sách tham khảo Vấn Đáp dùng chung với bản PC. Worker tải toàn bộ bảng về máy và cache
# 12 giờ; để trống = dùng URL mặc định trong quizReference.mjs. Không có nhánh hỏi Gemini.
QUIZ_DIRECTORY_URL=""

# Kho tin đàm đạo (MongoDB Atlas). Để trống = sảnh đàm đạo báo "chưa khai mở", phần còn lại
# của web chạy bình thường. Xem deploy/mongodb.md.
MONGODB_URI=""

# Tàng khố media — bytes của file đính kèm đàm đạo, ở OCI Object Storage.
# ĐẶT ĐỦ CẢ 5 HOẶC KHÔNG ĐẶT GÌ: thiếu hết = kho chưa khai mở (chat chữ vẫn chạy, chỉ đính
# kèm tạm nghỉ); thiếu một nửa = ném ngay kèm tên biến còn thiếu, vì nửa vời là lỗi cấu hình
# chứ không phải một trạng thái hợp lệ. Cách dựng: deploy/oracle/README.md.
OCI_REGION=""
OCI_NAMESPACE=""
OCI_BUCKET=""
OCI_ACCESS_KEY_ID=""
OCI_SECRET_ACCESS_KEY=""
