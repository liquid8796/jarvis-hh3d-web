# ============================================================================
# Jarvis HH3D Web — environment
# Copy to .env for local dev; set the same keys in Vercel → Project → Settings
# → Environment Variables for production.
# ============================================================================

# Neon Postgres connection string (Vercel Marketplace → Neon integration creates
# this automatically as DATABASE_URL; locally, copy it from the Neon dashboard).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 32+ random bytes, base64/hex — signs the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Mã hoá at-rest cho cookie game (AES-256-GCM). ĐÚNG 32 byte: 64 ký tự hex, hoặc base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MẤT KHOÁ NÀY = mọi cookie đã lưu không giải mã được nữa (người dùng phải dán lại).
# ĐỔI KHOÁ cũng vậy — hãy coi nó như một bí mật vĩnh viễn của deployment.
ENCRYPTION_KEY="change-me"

# Shared secret the automation worker presents on every call to /api/worker/*.
# Generate the same way as AUTH_SECRET. Rotate it to cut a worker off.
WORKER_TOKEN="change-me"

# First admin account, created by `npm run db:seed` (idempotent).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong"

# Địa chỉ web mà linh sứ gọi ngược về để nhận việc và kể chuyện. BẮT BUỘC trên Vercel nếu
# bật sandbox: VM sinh ra bên ngoài, nó không có cách nào tự đoán ra tên miền của bạn.
#   Vercel : https://<app>.vercel.app  (kèm scheme — thiếu https:// là fetch hỏng)
#   Máy nhà: để trống, worker tự dùng http://localhost:3000
# Nếu bỏ trống trên Vercel, sandbox rơi về VERCEL_PROJECT_PRODUCTION_URL (biến hệ thống,
# chỉ có hostname) — chạy được, nhưng đặt thẳng ở đây thì không phụ thuộc vào may rủi.
WEB_URL=""

# ---------------------------------------------------------------------------
# Linh sứ SANDBOX (Vercel Sandbox)
# ---------------------------------------------------------------------------
# Ảnh VM dựng sẵn (Chromium + agent-browser). Tạo một lần:
#   npx tsx scripts/createSandboxSnapshot.mts
# Không có nó, mỗi lát sandbox mất ~30s chỉ để cài lại Chromium.
# Bật linh sứ sandbox. MẶC ĐỊNH TẮT vì sandbox cần cron gọi /api/cron mỗi phút, mà gói
# Hobby của Vercel chỉ cho cron 1 lần/ngày. Chỉ đặt "1" khi bạn đã có cron đủ dày (gói Pro,
# hoặc một dịch vụ cron ngoài gọi vào kèm CRON_SECRET). Tắt = mọi job giao cho linh sứ máy nhà.
SANDBOX_ENABLED=""

AGENT_BROWSER_SNAPSHOT_ID=""

# Chỉ cần khi chạy sandbox TỪ MÁY NHÀ, và cũng chỉ khi bạn KHÔNG muốn dùng OIDC: sau một
# lần `vercel env pull`, .env đã có VERCEL_OIDC_TOKEN và cả SDK lẫn scripts/createSandbox‐
# Snapshot.mts đều tự xác thực bằng nó. Token cá nhân chỉ cần khi OIDC hết hạn (~12 giờ)
# mà bạn không tiện pull lại, hoặc khi chạy từ CI không có phiên Vercel CLI.
#   Token          : Vercel → Account Settings → Tokens
#   Team/Project ID: Vercel → Project → Settings → General
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_PROJECT_ID=""

# Cho phép gọi /api/cron từ bên ngoài. Cron thật của Vercel được nhận diện qua user-agent
# nên không cần biến này — nhưng nếu bạn dùng dịch vụ cron ngoài (cron-job.org…) để lách
# giới hạn 1 lần/ngày của gói Hobby thì đây là chìa khoá của nó.
CRON_SECRET=""

# Worker máy nhà nhận loại job nào (mặc định cả hai). Đặt "local" nếu muốn tách vai trò và
# thật sự có sandbox đang chạy.
WORKER_RUNNERS=""
