[Unit]
Description=Poll due Ollama companion work every five minutes

[Timer]
# The model chooses nextDecisionAt (5 minutes to 7 days); this timer only polls due work.
OnCalendar=*-*-* *:00/5:00
RandomizedDelaySec=30
AccuracySec=1s
# After downtime, poll once for work whose saved decision time is already due.
Persistent=true

[Install]
WantedBy=timers.target
